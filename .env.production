# Public base URL of the production site. Read by `next build` and inlined into the bundle,
# so it is used for canonical, hreflang, sitemap, robots, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://greyewi.dev

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = counter off.
NEXT_PUBLIC_GA_ID=G-0FQ8KMZJKJ
